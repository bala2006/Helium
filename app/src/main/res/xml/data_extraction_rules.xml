<?xml version="1.0" encoding="utf-8"?>
<!--
  Helium never opts user media into cloud backup. Project documents reference
  content:// URIs that are not portable between devices, so backing them up
  would only produce broken projects on restore.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
